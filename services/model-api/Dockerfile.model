FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MODEL_HOST=0.0.0.0 \
    MODEL_PORT=5000 \
    MODEL_PATH=/app/artifacts/ws50/final_model \
    ARTIFACTS_DIR=/app/artifacts \
    DATA_DIR=/app/data

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Build context is the continuum root, so ML sources live under services/model-api/.
COPY services/model-api/requirements.txt ./services/model-api/
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip \
    && python -m pip install --default-timeout=300 --retries=20 \
      "numpy<2" \
      pandas==2.2.2 \
      h5py==3.11.0 \
      scikit-learn==1.5.0 \
      flask==3.0.3 \
      python-dotenv \
      matplotlib

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --default-timeout=300 --retries=20 tensorflow-cpu==2.15.0

# The production web server, and the S3 client for MODEL_STORE=s3 (a layer of its own, so adding them
# did not invalidate the TensorFlow layer above).
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --default-timeout=300 --retries=20 gunicorn==23.0.0 boto3==1.40.0

COPY services/model-api/ ./services/model-api/

EXPOSE 5000

WORKDIR /app/services/model-api
CMD ["gunicorn", "-c", "gunicorn.conf.py", "wsgi:app"]
