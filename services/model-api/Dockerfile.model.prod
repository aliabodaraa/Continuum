# Production model-api image: fully self-contained. Unlike Dockerfile.model
# (dev), this bakes the source, the base models, and the mouse negative dataset
# INTO the image, so it needs no bind mounts and runs identically on any host.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MODEL_HOST=0.0.0.0 \
    MODEL_PORT=5000 \
    MODEL_DEBUG=0 \
    MODEL_PATH=/app/artifacts/ws50-gru-v2/final_model \
    ARTIFACTS_DIR=/app/artifacts \
    DATA_DIR=/app/data \
    HOME=/tmp

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Dependencies first (cached layer) — same stack as dev.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip \
    && python -m pip install --default-timeout=300 --retries=20 \
      "numpy<2" \
      pandas==2.2.2 \
      h5py==3.11.0 \
      scikit-learn==1.5.0 \
      flask==3.0.3 \
      python-dotenv \
      matplotlib \
    && python -m pip install --default-timeout=300 --retries=20 tensorflow-cpu==2.15.0 \
    && python -m pip install --default-timeout=300 --retries=20 gunicorn==23.0.0 boto3==1.40.0 \
      opentelemetry-sdk==1.26.0 opentelemetry-exporter-otlp-proto-http==1.26.0 \
      opentelemetry-instrumentation-flask==0.47b0 opentelemetry-instrumentation-botocore==0.47b0

# Only the files that serve requests. The ~90 research and evaluation scripts in services/model-api stay
# in the repository (the thesis records name them there) and never enter this image. Build context is
# the continuum root; the services/model-api/ prefix keeps the dev (bind-mounted) layout.
COPY services/model-api/api.py services/model-api/model.py services/model-api/preprocessing.py \
     services/model-api/loso.py services/model-api/model_store.py services/model-api/wsgi.py \
     services/model-api/gunicorn.conf.py ./services/model-api/

# The two base models and what comes with them: the keystroke base (ws50-gru-v2: network and scaler) and
# the mouse base (mouse-fcn-a5: network, scaler, F2 cohort). Research outputs under artifacts/ stay out.
# ws50-gru-v2 (Lu et al.'s best Buffalo setting: Conv1D 32 with kernel 2, max pooling 2, two GRU layers of
# 16 units) is the base every typing result in the paper was measured with. It replaced ws50-gru (two GRU
# layers of 32 units, no pooling) on 2026-10-25; the two share the scaler.
COPY artifacts/ws50-gru-v2/ ./artifacts/ws50-gru-v2/
COPY artifacts/mouse-fcn-a5/ ./artifacts/mouse-fcn-a5/

# Mouse enrollment's negative pool: the (|dx|, |dy|) windows of the 100 SapiMouse base users
# (train_mouse_fcn.py), api.py's MOUSE_NEG_DATASET_PATH default.
COPY data/mouse_only/Mouse_A5_W50_base.h5 ./data/mouse_only/Mouse_A5_W50_base.h5
# Keystroke training's negative pool: 200 Aalto typists (build_aalto_negatives.py), the path
# ca-service sends (KEYSTROKE_NEGATIVES_PATH default).
COPY data/aalto_neg_A200.h5 ./data/aalto_neg_A200.h5

# Not root: numeric (Kubernetes runAsNonRoot can check it), the only writable folder the per-user models
# (a new volume takes this owner; one made by an older image needs a one-time chown, DEPLOY.md).
RUN mkdir -p /app/artifacts/users && chown 1000:1000 /app/artifacts/users
USER 1000:1000

EXPOSE 5000

WORKDIR /app/services/model-api
CMD ["gunicorn", "-c", "gunicorn.conf.py", "wsgi:app"]
