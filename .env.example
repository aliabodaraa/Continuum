# Copy to `.env` and adjust before `docker compose -f docker-compose.prod.yml up`.
# Docker Compose auto-loads .env for these ${VARS}.

# ---- Public identity (WebAuthn passkeys are cryptographically bound to this) ----
# Local:  PUBLIC_ORIGIN=http://localhost:3000   RP_ID=localhost
# Domain: PUBLIC_ORIGIN=https://auth.example.com RP_ID=auth.example.com  COOKIE_SECURE=1
PUBLIC_ORIGIN=http://localhost:3000
RP_ID=localhost

# Host port to expose the web app on (container is always 3000 internally).
WEB_PORT=3000

# Set to 1 only when served over HTTPS (enables Secure cookies).
COOKIE_SECURE=0

# Session signing secret — REQUIRED (compose errors if unset). Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Shared secret between the web app and the passkey service (defense in depth on
# the private network). Leave blank for local dev; set a random value in prod.
PASSKEY_API_KEY=
# User-study logging in ca-service (extension/STUDY_MODE.md): 1 = log requests that carry a study context.
# The operator page (<gateway>/operator.html, Settings) can switch it at run time.
STUDY_LOGGING=0

# ---- Protection defaults for every organisation ----
# Each organisation chooses its own in its console (Protection tab); the operator page sets the
# defaults for all of them; these lines are the defaults below both (services/gateway/settings.js).
# Passed to the gateway AND ca-service.
# The small Continuum panel on the pages: show | hide (hidden = users can't switch or add samples).
CONTINUUM_PANEL=show
# The typing and the mouse channels: on | off. Off is refused by ca-service, not just hidden.
CONTINUUM_KEYSTROKE=on
CONTINUUM_MOUSE=on
# eager = users enrol typing and mouse at their first sign-in; lazy = when they turn a channel on
# in the panel (needs the panel).
ONBOARDING_MODE=eager
# Field types never monitored, comma-separated.
MONITOR_EXCLUDE_TYPES=hidden
# Adaptive retraining (the "Contribute sample" popup): on | off. Three non-overlapping samples, then the
# user retrains with a passkey, then a pause of ADAPTIVE_MIN_GAP_HOURS before new samples.
ADAPTIVE_RETRAINING=on
ADAPTIVE_MIN_GAP_HOURS=3
# Windows in the typing decision: 6 | 10 | 20 (half must look wrong). Fewer decide sooner but flag the
# real user more often; 20 is the measured default (the paper's figures).
KEYSTROKE_DECISION_WINDOWS=20

# ---- model-api service credential (REQUIRED in prod + bundle) ----
# Authenticates the ca-service -> model-api hop. model-api rejects every route except
# /health without it. This matters more than the other two keys: model-api scores
# caller-supplied windows against a NAMED user's model, so reachability without a
# credential is a biometric oracle — submit candidate windows for a victim, read back the
# genuine probability, and hill-climb a forgery. The same reach covers /api/user/train
# (poison a model) and /api/user/rollback (revert one).
#
# It is a SERVICE credential: it answers "is this ca-service?", not "may this request act
# for this person?" — that is settled one hop earlier by the gateway's RS256 identity
# assertion. Set the SAME value for model-api and ca-service. Generate:
#   openssl rand -hex 32
MODEL_API_KEY=

# Deadlines on that hop (ms). Inference sits in the authentication path, so its bound is a
# latency budget: past it ca-service returns 503 model_unavailable and issues NO verdict,
# rather than hanging on a wedged TensorFlow process. Training is a batch job via the
# durable queue and gets minutes.
MODEL_INFER_TIMEOUT_MS=5000
MODEL_TRAIN_TIMEOUT_MS=600000

# Model architecture width (must match how the base models were trained).
MODEL_UNITS=32

# ---- Signed risk verdicts (CA signs, host middleware verifies) ----
# The CA service signs verdicts with CA_SIGNING_SECRET; the host app's
# @continuum/node middleware verifies with the SAME value. REQUIRED (compose
# errors if unset) — a shared default would let any deployment forge another's
# verdicts. Generate with:  openssl rand -hex 32
CA_SIGNING_SECRET=

# ---- Product bundle (docker-compose.bundle.yml) ----
# Gateway session/identity secret. Signs session tokens AND derives this
# deployment's user-id namespace. REQUIRED (compose errors if unset), must be
# UNIQUE per deployment, and must NOT change afterwards (changing it re-derives
# every user id). Generate with:  openssl rand -hex 32
GATEWAY_SESSION_SECRET=
# Admin key for tenant registration (POST/GET /v1/tenants, sent as X-Admin-Key),
# and for the operator page (<gateway>/operator.html), where organisations that
# signed up in the console are approved or revoked. REQUIRED by the bundle
# (compose errors if unset): without it anyone who can reach the gateway can
# register or approve a tenant. Unset in dev = open, with a warning in the
# gateway log. 10 wrong keys pause operator sign-in for 15 minutes.
# Generate with:  openssl rand -hex 32
GATEWAY_ADMIN_KEY=
# Host names on which the operator page and the admin API answer at all;
# anywhere else they are "Not found". Default: localhost,127.0.0.1,[::1], i.e.
# only on the gateway's own machine (reach it from elsewhere through an SSH
# tunnel). With the default, a request that came through a reverse proxy
# (Forwarded / X-Forwarded-* headers) is never local. "*" = any host.
GATEWAY_OPERATOR_HOSTS=
# 1 = console users may register webhooks on localhost, private IPs or
# internal names. Off by default: the gateway itself calls the webhook, so
# such an address would let a console user reach internal services (SSRF).
# Local testing only.
GATEWAY_ALLOW_PRIVATE_WEBHOOKS=0
# Where browsers reach the gateway. Its pages (console, the extension's
# sign-in, the study) live there, and so do the passkeys made on them.
GATEWAY_PUBLIC_URL=http://localhost:8080
# The Continuum Guard extension's id (chrome://extensions, or its settings
# page). The personal and demo tenants admit it; the console offers it to
# organisations. An unpacked extension's id depends on its folder.
CONTINUUM_EXTENSION_ID=
# 1 = organisations that sign up in the console are active at once, without
# the operator's approval (a closed deployment only).
GATEWAY_AUTO_APPROVE_TENANTS=0
# Comma-separated tenant API keys for the gateway (blank = open, dev only).
GATEWAY_API_KEYS=
GATEWAY_PORT=8080
# Where each service keeps its records. One PostgreSQL server can hold all of them,
# but each service gets ITS OWN database and login (never a shared one).
# Gateway (organisations, accounts, identity map, settings, activity log, short-lived
# state, webhook outbox): json = files in its data directory (one gateway); postgres =
# GATEWAY_DATABASE_URL, so several copies can share them. Move the files over with:
#   node services/gateway/migrate.js --from <data dir> --to <GATEWAY_DATABASE_URL>
# With postgres the two signing keys (.pem) must be provided (a mounted secret).
GATEWAY_STORAGE=json
GATEWAY_DATABASE_URL=
# Passkey service (credentials, challenges): sqlite = its file; postgres =
# PASSKEY_DATABASE_URL. Move the file over with:
#   node services/passkey-service/migrate.js --from <passkey.db> --to <PASSKEY_DATABASE_URL>
PASSKEY_STORAGE=sqlite
PASSKEY_DATABASE_URL=
# CA service (typing and mouse samples, models' records, decisions, training queue,
# study log): sqlite = its file; postgres = CA_DATABASE_URL, so several copies can
# share it. Its database sorts text byte by byte (LC_COLLATE 'C'; see
# deploy/postgres/init-local.sql). Stop the service, then move the file over with:
#   node services/ca-service/migrate.js --from <ca.db> --to <CA_DATABASE_URL>
CA_STORAGE=sqlite
CA_DATABASE_URL=
# json = each log line is one JSON object (time, level, service, msg), for a log
# collector; empty = readable text.
LOG_FORMAT=
# Only on the demo machine (docker-compose.prod.yml): the demo organisation's sign-in
# page for the browser extension, and its risk-change receiver.
DEMO_SIGNIN_URL=
DEMO_WEBHOOK_URL=

# ---- Image coordinates (build/push + pull) ----
# REGISTRY is your Docker Hub username (or e.g. ghcr.io/<owner>). Images publish
# as ${REGISTRY}/model-api:${TAG}, ${REGISTRY}/ca-service:${TAG}, etc.
# Leave REGISTRY as the local default if you only build locally (no push).
REGISTRY=continuum
TAG=latest
