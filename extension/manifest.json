{
  "manifest_version": 3,
  "name": "Continuum Guard",
  "version": "0.1.0",
  "description": "Continuous authentication by keystroke & mouse rhythm \u2014 on-device, privacy-first.",
  "permissions": [
    "storage",
    "tabs",
    "offscreen",
    "scripting",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/features.js",
        "src/features-mouse.js",
        "src/features-mouse-actions.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Continuum Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "guard@continuum.dev",
      "strict_min_version": "115.0"
    }
  },
  "commands": {
    "toggle-study-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Continuum study: pause or resume recording"
    }
  }
}
